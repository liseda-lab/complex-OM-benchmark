  <rdf:Description rdf:about="http://aims.fao.org/aos/agrontology#isComposedOf">
    <owl:inverseOf rdf:resource="http://aims.fao.org/aos/agrontology#compose"/>
    <rdfs:subPropertyOf rdf:resource="http://aims.fao.org/aos/agrontology#hasPart"/>
    <rdfs:label xml:lang="en">Is composed of</rdfs:label>
    <rdfs:comment xml:lang="en">X &lt;isComposedOf&gt; Y. A relation in which X composed of Y holds is one where Y consists of the material or substance of which X is made.  This relation also subsumes &lt;ingredientOf&gt; and &lt;substanceOf&gt; relations. E.g. blood &lt;composedOf&gt; blood cell, blood gas, blood lipid, blood protein; beer &lt;composedOf&gt;  water, yeast, (and by inheritance hops c.f. &lt;madeFrom&gt;).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
