  <rdf:Description rdf:about="http://aims.fao.org/aos/agrontology#hasComponent">
    <owl:inverseOf rdf:resource="http://aims.fao.org/aos/agrontology#isComponentOf"/>
    <rdfs:subPropertyOf rdf:resource="http://aims.fao.org/aos/agrontology#hasPart"/>
    <rdfs:label xml:lang="en">Has component</rdfs:label>
    <rdfs:comment xml:lang="en">Y &lt;hasComponent&gt; X. An object X that is a part of a whole Y and has also an existence independently from Y. E.g. engine &lt;hasComponent&gt; engine part; tree &lt;hasComponent&gt; leaf; cell &lt;hasComponent&gt; chromosome; but NOT blood &lt;hasComponent&gt; blood cell (see &lt;composedOf&gt;).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
