  <rdf:Description rdf:about="http://aims.fao.org/aos/agrovoc/c_5415">
    <j.2:hasMember rdf:resource="http://aims.fao.org/aos/agrovoc/c_2012"/>
    <j.1:scopeNote xml:lang="en">Ornamental plants flowering and fruiting once and then dying</j.1:scopeNote>
    <j.4:altLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_fa_1299493425443"/>
    <j.1:scopeNote xml:lang="fa">گیاهان تزئینی که یک بار شکوفه داده و میوه می‌دهند سپس می‌میرند.</j.1:scopeNote>
    <j.2:hasMember rdf:resource="http://aims.fao.org/aos/agrovoc/c_513"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_sk_1299493424944"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_pl_1299493424835"/>
    <j.1:scopeNote xml:lang="cs">Okrasné rostliny kvetoucí a plodící jednou a potom odumírající</j.1:scopeNote>
    <j.1:scopeNote xml:lang="fr">Plante ornementale qui ne fleurit et fructifie qu'une seule fois, et qui meurt après</j.1:scopeNote>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_cs_1299493424537"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_hu_1299493424685"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_zh_1299493425189"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_pt_1299493424870"/>
    <j.1:scopeNote xml:lang="de">Einmal bluehende und fruchtende und dann absterbende Zierpflanzen</j.1:scopeNote>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_ru_1299493424907"/>
    <j.1:scopeNote xml:lang="it">Piante ornamentali che fioriscono e fruttificano una sola volta e poi muoiono</j.1:scopeNote>
    <j.1:scopeNote xml:lang="hu">Egyszer virágzó, ill. termést hozó, és ezt követoen elpusztuló dísznövény</j.1:scopeNote>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_it_1299493424711"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_ar_1299493424521"/>
    <j.1:broader rdf:resource="http://aims.fao.org/aos/agrovoc/c_5417"/>
    <j.1:inScheme rdf:resource="http://aims.fao.org/aos/agrovoc"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_de_1299493424554"/>
    <j.2:hasMember rdf:resource="http://aims.fao.org/aos/agrovoc/c_3539"/>
    <j.1:scopeNote xml:lang="lo">ພືດປະດັບທີ່ອອກດອກ ແລະ ໝາກພຽງຄັ້ງດຽວ ແລ້ວ ຕາຍ</j.1:scopeNote>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_fa_1299493424612"/>
    <j.0:created>1981-01-09T00:00:00Z</j.0:created>
    <j.2:includes rdf:resource="http://aims.fao.org/aos/agrovoc/c_2277"/>
    <j.2:includes rdf:resource="http://aims.fao.org/aos/agrovoc/c_5033"/>
    <j.0:modified>2007-04-20T01:33:18Z</j.0:modified>
    <j.1:scopeNote xml:lang="pt">Plantas ornamentais que dão flor e fruto uma vez e depois morrem</j.1:scopeNote>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_en_1299493424572"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <j.1:scopeNote xml:lang="es">Plantas ornamentales que florecen y frutifican una vez y mueren</j.1:scopeNote>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_ja_1299493424740"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_ko_1299493424770"/>
    <j.1:scopeNote xml:lang="th">ไม้ดอกไม้ประดับและไม้ผลที่ให้ดอกและผลเพียงครั้งเดียวแล้วแห้งตาย</j.1:scopeNote>
    <j.1:scopeNote xml:lang="pl">Rośliny ozdobne kwitnące i owocujące raz w życiu, później obumierające</j.1:scopeNote>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_hi_1299493424660"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_th_1299493424984"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_es_1299493424592"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_lo_1299493424802"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_fr_1299493424635"/>
  </rdf:Description>
