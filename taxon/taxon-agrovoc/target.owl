  <rdf:Description rdf:about="http://aims.fao.org/aos/agrovoc/c_5993">
    <j.2:isUsedAs rdf:resource="http://aims.fao.org/aos/agrovoc/c_36583"/>
    <j.1:scopeNote xml:lang="de">Pflanzen als botanischer Begriff; fuer Nutzpflanzen &lt;1972&gt; benutzen. Siehe auch die einzelnen Pflanzenfamilien</j.1:scopeNote>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_ko_1299492486781"/>
    <j.1:exactMatch rdf:resource="http://dewey.info/class/580/"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_cs_1299492486457"/>
    <j.0:created>2011-11-20T20:21:01Z</j.0:created>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_pt_1299492486880"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_ka_2cb0bb28"/>
    <j.1:scopeNote xml:lang="th">พืชทางพฤกษศาสตร์, สำหรับพืชที่สามารถใช้ประโยชน์ได้ใช้ &lt;1972&gt;, ดูแต่ละวงศ์ของพืชด้วย</j.1:scopeNote>
    <j.1:broader rdf:resource="http://aims.fao.org/aos/agrovoc/c_49904"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_fr_1299492486557"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <j.1:exactMatch rdf:resource="http://cat.aii.caas.cn/concept/57629"/>
    <j.1:inScheme rdf:resource="http://aims.fao.org/aos/agrovoc"/>
    <j.1:scopeNote xml:lang="hu">Növény, mint botanikai meghatározás; Haszonnövény: &lt;1972&gt;</j.1:scopeNote>
    <j.1:related rdf:resource="http://aims.fao.org/aos/agrovoc/c_330074"/>
    <j.1:scopeNote xml:lang="it">Piante come entità botaniche; per le piante utili usare &lt;1972&gt;; vedere anche le singole famiglie di piante</j.1:scopeNote>
    <j.1:scopeNote xml:lang="pl">W sensie botanicznym; dla roślin użytkowych używaj &lt;1972&gt; zobacz także poszczególne rodziny roślin</j.1:scopeNote>
    <j.1:exactMatch rdf:resource="http://lod.nal.usda.gov/nalt/874"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_ar_1299492486440"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_zh_1299492487184"/>
    <j.1:scopeNote xml:lang="es">Entidades botánicas; para plantas útiles use &lt;1972&gt;</j.1:scopeNote>
    <j.1:scopeNote xml:lang="fr">Entité botanique; pour les plantes utiles utiliser &lt;1972&gt;; voir aussi au nom des familles des plantes</j.1:scopeNote>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_sk_1299492486990"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_ms_1310437190725"/>
    <j.4:altLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_fr_1299492487327"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_ru_1299492486952"/>
    <j.1:scopeNote xml:lang="cs">Rostliny jako botanické entity; pro užitkové rostliny USE PLODINY; viz rovnìž jednotlivé èeledi rostlin</j.1:scopeNote>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_hi_1299492486586"/>
    <j.1:broadMatch rdf:resource="http://cat.aii.caas.cn/concept/57651"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_ja_1299492486754"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_de_1299492486476"/>
    <j.2:includes rdf:resource="http://aims.fao.org/aos/agrovoc/c_2983"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_th_1299492487142"/>
    <j.1:scopeNote xml:lang="pt">Planta como entidade botânica; para plantas úteis usar &lt;1972&gt;; ver também famílias individuais de plantas</j.1:scopeNote>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_ro_535aac02"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_lo_1299492486808"/>
    <j.1:exactMatch rdf:resource="http://d-nb.info/gnd/4045539-7"/>
    <j.1:scopeNote xml:lang="tr">Botanik açıdan bitkiler için kullan; yararlı bitkiler için &lt;1972&gt; kodlu terimi kullan; ayrıca bitkinin ait olduğu aileyi incelen</j.1:scopeNote>
    <j.1:scopeNote xml:lang="fa">گیاهان به عنوان یک نهاد گیاه‌شناسی؛ برای گیاهان مفید به کار برید محصولات گیاهی (کشاورزی)، همچنین تیره‌های جداگانه هر گیاه را ببینید.</j.1:scopeNote>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_it_1299492486664"/>
    <j.0:modified>2017-11-17T14:51:01Z</j.0:modified>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_es_1299492486515"/>
    <j.1:scopeNote xml:lang="en">Plants as botanical entity; for useful plants use &lt;1972&gt;; see also individual families of plants</j.1:scopeNote>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_uk_b803fc44"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_pl_1299492486843"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_en_1299492486495"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_hu_1299492486635"/>
    <j.1:closeMatch rdf:resource="http://purl.org/bncf/tid/1037"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_tr_5993_1321791661755"/>
    <j.4:prefLabel rdf:resource="http://aims.fao.org/aos/agrovoc/xl_fa_1299492486535"/>
    <j.1:scopeNote xml:lang="lo">ພືດ ຕາມທີ່ກຳນົດກັນທາງພືດສາດ; ສຳລັບພືດທີ່ເປັນປະໂຍດ ໃຊ້ &lt;1972&gt;; ໃຫ້ອ້າງອີງໃສ່ຄອບຄົວພືດແຕ່ລະຢ່າງດ້ວຍ</j.1:scopeNote>
  </rdf:Description>
